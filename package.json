{
  "name": "puntonet-prototipo",
  "private": true,
  "description": "Prototipo interactivo Puntonet (MATTE). La app no necesita build: se abre index.html directo en el navegador.",
  "scripts": {
    "test": "node tests/run-all.js",
    "vendor": "node tools/copiar-vendor.js",
    "www": "node tools/preparar-www.js",
    "sw": "node tools/generar-sw.js",
    "android:sync": "node tools/preparar-www.js && npx cap sync android",
    "android:open": "npx cap open android",
    "escritorio": "node tools/preparar-www.js && electron .",
    "escritorio:instalador": "node tools/preparar-www.js && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fontsource/inter": "5.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "html2canvas": "1.4.1",
    "jsdom": "30.1.1",
    "jspdf": "4.2.1",
    "three": "0.128.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2"
  },
  "main": "electron/main.js",
  "version": "1.0.0",
  "build": {
    "appId": "com.puntonet.configurador",
    "productName": "Configurador Puntonet",
    "directories": {
      "output": "dist-escritorio"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Configurador Puntonet",
      "runAfterFinish": true,
      "artifactName": "Configurador-Puntonet-Instalador-${version}.${ext}"
    },
    "publish": null
  }
}
